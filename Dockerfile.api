FROM mcr.microsoft.com/windows/servercore:ltsc2022
SHELL ["powershell", "-NoLogo", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Bump to the current 22.x or 24.x LTS from https://nodejs.org/en/download
ARG NODE_VERSION=22.14.0
RUN $v = $env:NODE_VERSION; \
    $base = \"https://nodejs.org/dist/v$v\"; \
    Invoke-WebRequest -UseBasicParsing \"$base/node-v$v-win-x64.zip\" -OutFile C:\node.zip; \
    $sums = (Invoke-WebRequest -UseBasicParsing \"$base/SHASUMS256.txt\").Content -split \"`n\"; \
    $expected = (($sums | Where-Object { $_ -match \"node-v$v-win-x64\.zip$\" }) -split '\s+')[0]; \
    if (-not $expected -or (Get-FileHash C:\node.zip -Algorithm SHA256).Hash -ne $expected) { throw 'Node.js checksum mismatch' }; \
    Expand-Archive C:\node.zip -DestinationPath C:\; \
    Rename-Item \"C:\node-v$v-win-x64\" C:\nodejs; \
    Remove-Item C:\node.zip

WORKDIR C:/app
COPY package.json package-lock.json ./
RUN cmd.exe /c C:\nodejs\npm.cmd ci --omit=dev
COPY app.js ./

USER ContainerUser
EXPOSE 3000
CMD ["C:/nodejs/node.exe", "app.js"]