[Unit]
Description=Local Tasks API (container image from Docker Hub)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
# ALLOWED_REPO, e.g. docker.io/<namespace>/local-tasks (root-owned, set by setup-server.sh).
EnvironmentFile=/etc/local-tasks/deploy.conf
# IMAGE=<ALLOWED_REPO>@sha256:<digest>, written by the Jenkins deploy stage.
EnvironmentFile=/opt/local-tasks/image.env
ExecStartPre=/usr/local/lib/local-tasks/check-image
ExecStartPre=/usr/bin/podman pull --quiet ${IMAGE}
# Host network keeps the API on 127.0.0.1:8083 (behind nginx) and lets it reach
# PostgreSQL on 127.0.0.1. The container itself is locked down.
ExecStart=/usr/bin/podman run --rm --replace --name local-tasks \
    --network host \
    --env-file /etc/local-tasks/app.env \
    --user 1000:1000 \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --pids-limit 256 \
    --memory 256m \
    ${IMAGE}
ExecStop=/usr/bin/podman stop --ignore --time 10 local-tasks
Restart=on-failure
RestartSec=5
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
